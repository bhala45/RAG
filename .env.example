# ==============================================================================
# CampusWise AI — Environment Configuration Guide
# ==============================================================================
# Copy and place the relevant variables into server/.env and client/.env.local

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (Save as `server/.env`)
# ------------------------------------------------------------------------------

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI (With Vector Search enabled cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campuswise_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_campuswise_ai_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (Save as `client/.env.local`)
# ------------------------------------------------------------------------------

# Public Backend API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
