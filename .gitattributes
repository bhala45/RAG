# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.env.example text eol=lf
*.env.local.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Denote all binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
